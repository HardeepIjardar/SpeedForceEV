{
  "name": "speedforceev-server",
  "version": "1.0.0",
  "description": "Server for SpeedForceEV Live Fleet Stats API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop speedforceev-server",
    "pm2:restart": "pm2 restart speedforceev-server",
    "pm2:logs": "pm2 logs speedforceev-server",
    "pm2:delete": "pm2 delete speedforceev-server",
    "prepare-data": "node -e \"const fs=require('fs');const d='./data';if(!fs.existsSync(d))fs.mkdirSync(d);if(!fs.existsSync(d+'/counter.json'))fs.writeFileSync(d+'/counter.json', JSON.stringify({greenKm:7000000}));console.log('data prepared')\"",
    "start:prod": "NODE_ENV=production node server.js"
  },
  "keywords": [
    "speedforceev",
    "fleet",
    "stats",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.27.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
